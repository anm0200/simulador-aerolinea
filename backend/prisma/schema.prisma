generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Airport {
  id        String   @id
  name      String
  city      String
  country   String
  lat       Float
  lng       Float
  originFlights      Flight[] @relation("OriginAirport")
  destinationFlights Flight[] @relation("DestinationAirport")
}

model Flight {
  id              String   @id
  originId        String
  destinationId   String
  departureTime   String
  durationMinutes Int
  isDaily         Boolean  @default(true)
  isActive        Boolean  @default(true)
  
  origin      Airport @relation("OriginAirport", fields: [originId], references: [id])
  destination Airport @relation("DestinationAirport", fields: [destinationId], references: [id])
  reservations Reservation[]
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(CLIENTE)
  createdAt DateTime @default(now())
  
  reservations Reservation[]
}

model Reservation {
  id        String   @id @default(uuid())
  userId    String
  flightId  String
  createdAt DateTime @default(now())
  
  user   User   @relation(fields: [userId], references: [id])
  flight Flight @relation(fields: [flightId], references: [id])
}

enum Role {
  RESPONSABLE
  CLIENTE
}
